{
  "name": "vaelen-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A small, dependency-free coding agent harness for the terminal.",
  "license": "MIT",
  "keywords": [
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "openai-compatible"
  ],
  "type": "module",
  "bin": {
    "vaelen": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node test/unit.mjs && node test/smoke.mjs && node test/stress.mjs && node test/e-drive-stress.mjs",
    "test:ci": "node test/unit.mjs && node test/smoke.mjs && node test/stress.mjs",
    "test:edrive": "node test/e-drive-stress.mjs",
    "test:unit": "node test/unit.mjs",
    "test:stress": "node test/stress.mjs",
    "smoke": "node test/smoke.mjs",
    "gui": "node scripts/build-gui.mjs && node dist/gui.cjs",
    "exe": "node scripts/build-gui.mjs --exe",
    "test:gui": "node test/gui-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.7.2"
  }
}
